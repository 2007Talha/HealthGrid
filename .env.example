# Google Cloud Platform Configuration
GCP_PROJECT_ID=
GCP_REGION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=
SECRET_MANAGER_ENABLED=false

# BigQuery Analytics Foundation
BIGQUERY_DATASET=swasthyagrid
BIGQUERY_LOCATION=asia-south1

# Gemini Operations Copilot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Application Environment & Security
ENVIRONMENT=development
# Options: development, demo, production
SECRET_KEY=swasthyagrid-dev-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Rate Limiting (requests per minute for expensive operations)
RATE_LIMIT_PER_MINUTE=60

# Frontend Configuration (Vite)
VITE_API_BASE_URL=/api/v1
VITE_DEMO_MODE=true
